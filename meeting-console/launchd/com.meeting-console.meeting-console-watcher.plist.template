<?xml version="1.0" encoding="UTF-8"?>
<!--
  회의 노트 초안 워처 (5분마다 조건에 맞는 폴더를 찾아 초안을 만든다)

  ⚠️ 경로를 하드코딩하지 않는다. __UV__ · __REPO__ · __PATH__ 를 설치 시점 값으로 바꿔 쓴다.
     (지금 쓰는 com.meeting-console.meeting-recorder.plist 에는 사용자 홈 절대 경로가 박혀 있어
      다른 계정에서 그대로 못 쓴다. 같은 실수를 반복하지 않으려고 템플릿으로 둔다.)

  설치:
    sed -e "s|__UV__|$(command -v uv)|g" \
        -e "s|__REPO__|$(pwd)|g" \
        -e "s|__PATH__|$(dirname "$(command -v uv)"):/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin|g" \
        outputs/vibe-coding/meeting-console/launchd/com.meeting-console.meeting-console-watcher.plist.template \
        > ~/Library/LaunchAgents/com.meeting-console.meeting-console-watcher.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.meeting-console.meeting-console-watcher.plist

  중지:
    launchctl bootout gui/$(id -u)/com.meeting-console.meeting-console-watcher

  로그: outputs/vibe-coding/meeting-console/logs/watcher.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meeting-console.meeting-console-watcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>--quiet</string>
    <string>__REPO__/outputs/vibe-coding/meeting-console/watcher.py</string>
    <string>--once</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__REPO__/outputs/vibe-coding/meeting-console/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/outputs/vibe-coding/meeting-console/logs/launchd.err.log</string>
</dict>
</plist>
